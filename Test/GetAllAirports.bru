meta {
  name: GetAllAirports
  type: http
  seq: 1
}

get {
  url: {{BASE_URL}}/airports
  body: none
  auth: inherit
}

script:post-response {
  const airportsData = res.getBody().data;
  // const airportIds = airportsData.id;
  if(airportsData.length>0){
    const sourceAirport = airportsData[Math.floor(Math.random() * airportsData.length)];
    bru.setEnvVar("sourceAirport", sourceAirport.id);
    const destinationAirport = airportsData[Math.floor(Math.random() * airportsData.length)];
    bru.setEnvVar("destinationAirport", destinationAirport.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
